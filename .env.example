# Copy to .env.local and fill in. Document every new variable here.

# Postgres connection strings. Locally: a Neon development branch.
# The app uses the pooled URL (hostname ends in -pooler); migrations use the direct one when set.
DATABASE_URL=postgres://user:password@host-pooler/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, used to build the OAuth callback URL.
BETTER_AUTH_URL=http://localhost:4837

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials, type "Web application").
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign in.
ALLOWED_EMAILS=you@example.com

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey). Optional: without it,
# proposing tasks shows an error. AI_MODEL overrides the default Flash model.
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL=gemini-3.5-flash
# Test-only: AI_FAKE=1 replaces Gemini with deterministic proposals (e2e and CI).
# AI_FAKE=1

# Secret for the daily job at /api/cron/daily (Vercel Cron sends it as a bearer token).
# Required in Vercel production; generate it with: openssl rand -base64 32
# CRON_SECRET=
# Test-only: CALENDAR_FAKE=1 replaces Google Calendar with an in-memory fake (e2e and CI).
# CALENDAR_FAKE=1

# Push notifications (ADR 0010). Without all six, the notifications page says they aren't set up.
# VAPID keys: pnpm dlx web-push generate-vapid-keys. The subject is a mailto: or https:// URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# QStash (Upstash console > QStash): the token and both signing keys. QSTASH_URL only for a
# non-default region.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=
# Test-only: PUSH_FAKE=1 offers notifications without queuing or pushing anything (e2e and CI).
# PUSH_FAKE=1
